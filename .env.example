# 복사해서 .env 로 사용합니다(cp .env.example .env). .env 는 절대 커밋하지 않습니다.

# 세션 서명 키. 운영에서는 반드시 새 값으로 바꿉니다(COOKIE_SECURE=true 이면 기본값 사용 시 서버가 기동을 거부).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# 운영(HTTPS 리버스 프록시 뒤): true.  로컬 HTTP 개발: false (true 이면 브라우저가 쿠키를 보내지 않아 로그인되지 않음)
COOKIE_SECURE=true

# 로컬 실행 시 DB 위치. Docker Compose 에서는 compose 파일이 /app/data/cbt.db 로 덮어씁니다.
DATABASE_URL=sqlite:///./data/cbt.db

# 메일(가입 승인 시 비밀번호, 비밀번호 재설정 링크 발송). Gmail 은 '앱 비밀번호'를 사용(587=STARTTLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 메일 속 링크의 기준 주소 = 응시자가 접속하는 주소(요청 헤더로 만들지 않음, 재설정 링크 위조 방지)
PUBLIC_BASE_URL=http://127.0.0.1:8000
