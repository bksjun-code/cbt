# /etc/ogg-cbt/env 로 복사해서 사용합니다(root:cbt, 권한 640). 이 파일은 저장소에 비밀값을 넣지 않기 위한 견본입니다.
# systemd EnvironmentFile 형식이므로 KEY=VALUE 한 줄씩, 따옴표·export 없이 씁니다.

# 세션 서명 키: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=여기에-새로-생성한-값을-넣으세요

# HTTPS(nginx) 뒤에서 운영하므로 true
COOKIE_SECURE=true

# DB 파일 (절대 경로, 슬래시 4개)
DATABASE_URL=sqlite:////var/lib/ogg-cbt/cbt.db

PYTHONDONTWRITEBYTECODE=1

# 메일(가입 승인 시 비밀번호, 비밀번호 재설정 링크 발송). Gmail 은 '앱 비밀번호'를 사용(587=STARTTLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 메일 속 링크의 기준 주소 = 응시자가 접속하는 주소(요청 헤더로 만들지 않음, 재설정 링크 위조 방지)
PUBLIC_BASE_URL=https://cbt.example.com
